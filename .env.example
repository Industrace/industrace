# ===========================================
# INDUSTRACE ENVIRONMENT CONFIGURATION
# ===========================================
# 
# This file contains environment variables used by Docker Compose files.
# Copy this file to .env and update the values according to your environment.
#
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env files to version control
# - Generate secure random values for all secrets
# - Use different values for development and production
# - For production, use 'make prod' which automatically generates secure values
#
# ===========================================

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Database password - REQUIRED for production, optional for development
# For production: Must be set (no default fallback)
# For development: Can use default 'changeme' if not set
# Generate secure password: openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
DB_PASSWORD=changeme

# Database connection details (automatically constructed from DB_PASSWORD)
# Format: postgresql://username:password@host:port/database
# These are set automatically in docker-compose files, but can be overridden:
# POSTGRES_USER=industrace_user
# POSTGRES_DB=industrace
# DATABASE_URL=postgresql://industrace_user:${DB_PASSWORD}@db:5432/industrace

# ===========================================
# SECURITY & AUTHENTICATION
# ===========================================

# JWT Secret Key - REQUIRED for production, optional for development
# Used for signing and verifying JWT tokens
# For production: Must be set (no default fallback)
# For development: Can use default 'changeme' if not set
# Generate secure key: openssl rand -hex 32
SECRET_KEY=changeme

# JWT Token expiration time (in minutes)
# Default: 30 minutes (configured in docker-compose files)
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption Key - REQUIRED for production with SSO, optional for development
# Used for encrypting sensitive data (e.g., SSO tokens)
# For production: Automatically generated by 'make prod', 'make prod-cloud', or 'make custom-certs-start'
# For development: Optional (temporary key will be generated if not set)
# Generate manually with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: ENCRYPTION_KEY=your-encryption-key-here
# ENCRYPTION_KEY=

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Environment type: development, production
# Set automatically by docker-compose files:
# - docker-compose.dev.yml: ENVIRONMENT=development
# - docker-compose.prod.yml: ENVIRONMENT=production
# - docker-compose.yml (Traefik): ENVIRONMENT=development
# ENVIRONMENT=development

# Debug mode: true for development, false for production
# Set automatically by docker-compose files:
# - docker-compose.dev.yml: DEBUG=true
# - docker-compose.prod.yml: DEBUG=false
# DEBUG=true

# CORS Origins - Allowed frontend origins
# Set automatically by docker-compose files based on environment:
# - Development: http://localhost:5173,http://localhost:3000
# - Production (Nginx): https://localhost,https://127.0.0.1,https://industrace.local
# - Production (Traefik): http://industrace.local,https://industrace.local,http://localhost,https://localhost
# - Custom Certs: https://${DOMAIN},https://${WWW_DOMAIN}
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SSO Redirect URI - Frontend URL used after successful SSO (NOT the OAuth redirect URI registered in Azure AD)
# Azure AD redirect URI must point to the BACKEND callback, e.g. https://your-domain/api/auth/sso/azure_ad/callback
# This variable is the frontend base used for post-login redirect to /auth/sso/success
# SSO_REDIRECT_URI=http://localhost:5173/auth/sso/callback

# ===========================================
# NETWORK PROBE (optional)
# ===========================================
# Rate limits per probe API key (SlowAPI format)
# PROBE_RATE_LIMIT_HEARTBEAT=120/minute
# PROBE_RATE_LIMIT_DATA=30/hour
# PROBE_RATE_LIMIT_CONFIG=60/hour
# Mark probe inactive when last heartbeat is older than N seconds (default 300)
# PROBE_HEARTBEAT_STALE_SECONDS=300
# Retention for probe_heartbeats and probe_data_transmissions (days, default 90)
# PROBE_RETENTION_DAYS=90

# Cookie Security Settings (Production only)
# Set automatically in docker-compose.prod.yml:
# SECURE_COOKIES=true
# SAME_SITE_COOKIES=strict

# ===========================================
# CUSTOM CERTIFICATES CONFIGURATION
# ===========================================
# These variables are used only with docker-compose.custom-certs.yml
# See custom-certs.env.example for detailed configuration

# Domain name for custom certificates deployment
# DOMAIN=industrace.internal
# WWW_DOMAIN=www.industrace.internal

# Certificate file paths (absolute paths on host)
# CERT_PATH=/path/to/your/certificate.crt
# KEY_PATH=/path/to/your/private.key
# CA_PATH=/path/to/your/ca.crt

# ===========================================
# USAGE BY DOCKER COMPOSE FILES
# ===========================================
#
# docker-compose.dev.yml (Development):
#   - Uses: DB_PASSWORD (default: changeme), SECRET_KEY (default: changeme)
#   - ENCRYPTION_KEY: Optional
#   - Other settings: Hardcoded in compose file
#
# docker-compose.prod.yml (Production with Nginx):
#   - Uses: DB_PASSWORD (REQUIRED), SECRET_KEY (REQUIRED), ENCRYPTION_KEY (REQUIRED for SSO)
#   - Generated on first 'make prod' and saved to .env.prod
#   - Subsequent 'make prod' reuses .env.prod (export DB_PASSWORD=... to regenerate)
#   - Other settings: Hardcoded in compose file
#
# docker-compose.yml (Production with Traefik):
#   - Uses: DB_PASSWORD (default: changeme), SECRET_KEY (default: changeme)
#   - ENCRYPTION_KEY: Optional
#   - Other settings: Hardcoded in compose file
#
# docker-compose.custom-certs.yml (Custom Certificates):
#   - Uses: DB_PASSWORD (REQUIRED), SECRET_KEY (REQUIRED), ENCRYPTION_KEY (REQUIRED)
#   - All three are automatically generated by 'make custom-certs-start' if not present in custom-certs.env
#   - Also requires: DOMAIN, WWW_DOMAIN, CERT_PATH, KEY_PATH, CA_PATH
#   - See custom-certs.env.example for full configuration
#
# ===========================================
# QUICK START
# ===========================================
#
# For Development:
#   1. Copy this file: cp .env.example .env
#   2. Optionally set DB_PASSWORD and SECRET_KEY (or use defaults)
#   3. Run: docker-compose -f docker-compose.dev.yml up -d
#
# For Production (Nginx):
#   1. Run: make prod (creates .env.prod on first run)
#   2. Later runs reuse .env.prod so DB password stays aligned with the volume
#   3. To rotate secrets: export DB_PASSWORD=... && make prod (then sync DB password if needed)
#
# For Production (Traefik):
#   1. Run: make prod-cloud
#   2. This will automatically generate secure DB_PASSWORD and SECRET_KEY
#   3. Values will be saved to .env.prod-cloud
#
# For Custom Certificates:
#   1. Copy: cp custom-certs.env.example custom-certs.env
#   2. Configure: DOMAIN, CERT_PATH, KEY_PATH, CA_PATH
#   3. Run: make custom-certs-start
#
# ===========================================
