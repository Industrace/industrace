# Custom Certificates Configuration
# Copy this file to custom-certs.env and update the paths
#
# IMPORTANT: Security variables (DB_PASSWORD, SECRET_KEY, ENCRYPTION_KEY) will be
# automatically generated by 'make custom-certs-start' if not present in this file.
# You can set them manually if you need specific values.

# Domain configuration
DOMAIN=industrace.internal
WWW_DOMAIN=www.industrace.internal

# Certificate paths (absolute paths on the host)
CERT_PATH=/path/to/your/certificate.crt
KEY_PATH=/path/to/your/private.key
CA_PATH=/path/to/your/ca.crt

# Optional: Certificate chain (if you have intermediate certificates)
CHAIN_PATH=/path/to/your/chain.crt

# Traefik dashboard configuration
TRAEFIK_DOMAIN=traefik.industrace.internal

# Email for Let's Encrypt fallback (optional)
ACME_EMAIL=admin@industrace.internal

# Security variables (automatically generated if not set)
# DB_PASSWORD=  # Generated automatically by 'make custom-certs-start'
# SECRET_KEY=   # Generated automatically by 'make custom-certs-start'
# ENCRYPTION_KEY=  # Generated automatically by 'make custom-certs-start'
